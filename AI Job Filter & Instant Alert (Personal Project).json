        "messages": {
          "values": [
            {
              "content": "=You are a recruitment assistant evaluating job posts for a tech/automation specialist.\nAnalyze the job below and return ONLY a valid JSON object (no markdown, no explanation) with these exact keys:\n- \"score\": integer from 1 to 10 based on clarity and relevance to software, AI, automation, or engineering roles\n- \"summary\": 1-2 short sentences summarizing the role\n- \"key_skills\": comma-separated list of 3-5 main skills mentioned (or \"General Tech\" if not listed)\n- \"draft_hook\": 1 short, natural opening sentence a candidate could use to apply\n\nJob Title: {{ $json.title }}\nJob Description: {{ $json.contentSnippet || $json.content || 'No details provided' }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "position": [
        672,
        0
      ],
      "id": "35fbe599-3a7f-4891-8826-6b5c43f2cee4",
      "name": "3. AI Analyze & Score"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const raw = $input.item.json;\nlet text =\n  raw?.content?.[0]?.text ||\n  raw?.message?.content ||\n  raw?.output?.[0]?.content?.[0]?.text ||\n  raw?.content?.parts?.[0]?.text ||\n  raw?.text ||\n  raw?.choices?.[0]?.message?.content ||\n  JSON.stringify(raw);\n\nconst cleaned = text.replace(/```json/gi, '').replace(/```/g, '').trim();\n\nlet parsed = {\n  score: 0,\n  summary: 'Could not parse AI output',\n  key_skills: 'N/A',\n  draft_hook: 'N/A'\n};\n\ntry {\n  const match = cleaned.match(/\\{[\\s\\S]*\\}/);\n  parsed = JSON.parse(match ? match[0] : cleaned);\n} catch (e) {\n  parsed.summary = cleaned.slice(0, 200);\n}\n\nconst source = $('2. Limit to 3 Items').item.json;\n\nreturn {\n  json: {\n    timestamp: new Date().toISOString(),\n    title: source.title || 'Untitled Job',\n    link: source.link || 'N/A',\n    score: Number(parsed.score) || 0,\n    summary: parsed.summary || 'No summary',\n    key_skills: Array.isArray(parsed.key_skills)\n      ? parsed.key_skills.join(', ')\n      : (parsed.key_skills || 'N/A'),\n    draft_hook: parsed.draft_hook || 'N/A'\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        0
      ],
      "id": "2dbaf7ba-322f-4db4-9609-a9a2e375cb4d",
